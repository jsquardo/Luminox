#!/usr/bin/env sh
set -e

export PORT="${PORT:-3000}"

# In Docker the project directory is a bind-mount, so these can persist between runs
rm -f .overmind.sock
rm -f tmp/pids/server.pid

if command -v overmind >/dev/null 2>&1; then
  exec overmind start -f Procfile.dev "$@"
fi

echo "overmind is not installed. Install it (brew install overmind) or ensure the dev container image includes it."
exit 1