# syntax=docker/dockerfile:1
# Dockerfile.dev — development version for Rails + Inertia + React

ARG RUBY_VERSION=3.4.5
FROM ruby:${RUBY_VERSION}-slim AS base

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update -qq && \
  apt-get install --no-install-recommends -y \
  build-essential \
  git \
  curl \
  libpq-dev \
  libyaml-dev \
  pkg-config \
  nodejs \
  npm && \
  npm install -g yarn && \
  rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# Set env variables for development
ENV RAILS_ENV=development \
  RAILS_LOG_TO_STDOUT=true \
  BUNDLE_PATH=/usr/local/bundle

# Copy Gemfile & install gems
COPY Gemfile Gemfile.lock ./
RUN bundle install --jobs 4 --retry 3

# Copy package.json & install JS dependencies
COPY package.json package-lock.json ./
RUN npm ci

# Copy the rest of the application code
COPY . .

RUN rm -f /app/tmp/pids/server.pid

# Expose necessary ports for dev:
# Rails default port 3000, Vite/React dev server e.g. 5173
EXPOSE 3000 5173

# Mount volumes if set via docker-compose (see compose file)

# Default command for dev: run your dev server script
CMD ["bash", "-lc", "bin/dev"]