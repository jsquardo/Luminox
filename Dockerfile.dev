# syntax=docker/dockerfile:1
# Dockerfile.dev — development version for Rails + Inertia + React

ARG RUBY_VERSION=3.4.7
FROM ruby:${RUBY_VERSION}-slim AS base

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update -qq && \
  apt-get install --no-install-recommends -y \
    build-essential \
    git \
    curl \
    ca-certificates \
    tmux \
    libpq-dev \
    libyaml-dev \
    pkg-config \
    nodejs \
    npm \
    autoconf \
    automake \
    libtool \
    libsecp256k1-dev \
    postgresql-client && \
  npm install -g yarn && \
  rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

ARG OVERMIND_VERSION=2.5.1
RUN set -eux; \
  arch="$(dpkg --print-architecture)"; \
  case "$arch" in \
    amd64) om_arch="linux-amd64" ;; \
    arm64) om_arch="linux-arm64" ;; \
    *) echo "Unsupported arch: $arch" && exit 1 ;; \
  esac; \
  curl -L "https://github.com/DarthSim/overmind/releases/download/v${OVERMIND_VERSION}/overmind-v${OVERMIND_VERSION}-${om_arch}.gz" \
    | gunzip -c > /usr/local/bin/overmind; \
  chmod +x /usr/local/bin/overmind

# Set env variables for development
ENV RAILS_ENV=development \
  RAILS_LOG_TO_STDOUT=true \
  BUNDLE_PATH=/usr/local/bundle

# Copy Gemfile & install gems
COPY Gemfile Gemfile.lock ./
RUN bundle install --jobs 4 --retry 3

# Copy package.json & install JS dependencies
COPY package.json package*.json ./
RUN npm install

# Copy the rest of the application code
COPY . .

RUN rm -f /app/tmp/pids/server.pid

# Expose necessary ports for dev:
# Rails default port 3000, Vite/React dev server e.g. 3036
EXPOSE 3000 3036

# Mount volumes if set via docker-compose (see compose file)

# Default command for dev: run your dev server script
CMD ["bash", "-lc", "bin/dev"]